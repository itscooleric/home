# Startpage Configuration
# Copy this file to .env and customize as needed

# Code directory (where the git repo is cloned)
# Default: /opt/stacks/startpage
STARTPAGE_CODE_DIR=/opt/stacks/startpage

# Data directory (where runtime files are stored)
# Default: /srv/startpage
STARTPAGE_DATA_DIR=/srv/startpage

# Hostname for caddy-docker-proxy
# This will be the URL to access the startpage
STARTPAGE_HOSTNAME=bernard.example.com

# Name of the external Caddy network
# Check with: docker network ls | grep caddy
CADDY_NETWORK=caddy

# User/Group IDs for file permissions (for filebrowser)
# Get your IDs with: id -u && id -g
PUID=1000
PGID=1000
